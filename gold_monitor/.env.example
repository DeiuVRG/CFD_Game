# Discord webhook for signal notifications (required for --monitor)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord user mention prepended to every notification (optional).
# Format: <@YOUR_DISCORD_USER_ID> - get the ID from Discord's "Copy User ID".
DISCORD_MENTION=<@YOUR_DISCORD_USER_ID>

# Twelve Data API key for real-time prices (optional fallback source;
# free tier: 800 requests/day). Leave empty to use TradingView/Yahoo only.
TWELVEDATA_API_KEY=

# --- Data fetch through restrictive proxies (optional, rarely needed) ---
# TLS impersonation profile for yfinance downloads (e.g. safari, chrome).
# Leave empty for the default behavior.
YF_IMPERSONATE=

# --- Sentinel (sentinel/) - DEMO-account supervisor, optional ---
# Anthropic API key for Claude Fable 5.1 (decisions + market research)
ANTHROPIC_API_KEY=
# Capital.com DEMO credentials (Settings -> API on capital.com). The sentinel
# refuses anything but CAPITAL_MODE=demo.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_MODE=demo
# Capital.com epics (verify with: python -m sentinel.main --markets gold)
SENTINEL_EPIC_GOLD=GOLD
SENTINEL_EPIC_BTC=BITCOIN
# true = log decisions, place no orders
SENTINEL_DRY_RUN=false
SENTINEL_WEB_SEARCH=true
