# Capital.com API credentials (https://capital.com -> Settings -> API)
CAPITAL_API_KEY=your_api_key_here
CAPITAL_IDENTIFIER=your_email@example.com
CAPITAL_PASSWORD=your_api_password

# demo | live  -- KEEP ON demo. Live mode is blocked by process until Gate 3
# (see README.md). Do not run live.
CAPITAL_MODE=demo
